{
  "name": "pixelkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "A free, privacy-first image toolkit that runs in your browser.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/make-fixtures.mjs && playwright test",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "shots": "node scripts/screenshots.mjs",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
